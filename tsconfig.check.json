{
  // Cheap type check of the plain-JS entry points (npm run typecheck). Needs a
  // prior `npm run build`: bin/ and hooks/ import from dist/ and read its types.
  // TODO: add "bin/**/*.mjs" to "include" once the 7 errors it reports today
  // (bin/crbro.mjs: `{}` literals used as objects, ModLang string, markFailed
  // narrowing) are fixed; bin/ belongs to the installers parcel.
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["hooks/**/*.mjs", "scripts/**/*.mjs"]
}
