{
  "name": "crbro-memory",
  "version": "2.12.1",
  "mcpName": "io.github.Octonove/crbro-memory",
  "description": "Local, persistent memory for AI agents (MCP server): plain JSON on your disk, search with an optional local semantic layer, corrections that replace old facts, stale-value warnings, a browser view to edit it. Claude Code, Claude Desktop, Codex, Cursor.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "crbro-memory": "bin/crbro.mjs"
  },
  "scripts": {
    "build": "tsc && node scripts/build-id.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test && node scripts/check-publication.mjs",
    "mcpb": "node scripts/build-mcpb.mjs",
    "mcpb:verify": "node scripts/verify-mcpb.mjs",
    "typecheck": "tsc -p tsconfig.check.json",
    "smoke": "node scripts/smoke-stdio.mjs",
    "perf": "node benchmarks/perf/nightly.mjs",
    "bench": "node benchmarks/retrieval/run.mjs --check && node benchmarks/security/run.mjs --check"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "memory",
    "persistent-memory",
    "long-term-memory",
    "agent-memory",
    "ai",
    "ai-agents",
    "llm",
    "claude",
    "claude-code",
    "codex",
    "cursor",
    "local-first",
    "semantic-search",
    "embeddings",
    "knowledge-base"
  ],
  "author": {
    "name": "Octonove",
    "url": "https://github.com/Octonove"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Octonove/crbro-memory.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist/",
    "!dist/**/*.map",
    "!dist/**/*.d.ts",
    "bin/",
    "hooks/",
    "mods/",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@orama/orama": "^3.1.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
